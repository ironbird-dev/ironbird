{
  "name": "@ironbird/cli",
  "version": "0.0.0",
  "description": "The ironbird daemon and CLI",
  "type": "module",
  "engines": { "node": ">=22" },
  "exports": {
    ".": { "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
    "./config": {
      "import": { "types": "./dist/config-entry.d.ts", "default": "./dist/config-entry.js" },
      "require": { "types": "./dist/config-entry.d.cts", "default": "./dist/config-entry.cjs" }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit"
  },
  "dependencies": {
    "@ironbird/core": "workspace:*",
    "esbuild": "^0.25.0",
    "zod": "^4.0.0"
  }
}
