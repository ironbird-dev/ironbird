{
  "name": "@ironbird/cli",
  "version": "0.0.1",
  "description": "The ironbird daemon and CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ironbird-dev/ironbird.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config-entry.d.ts",
        "default": "./dist/config-entry.js"
      },
      "require": {
        "types": "./dist/config-entry.d.cts",
        "default": "./dist/config-entry.cjs"
      }
    },
    "./bin": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "ironbird": "./dist/bin.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit --project serial"
  },
  "dependencies": {
    "@ironbird/core": "workspace:*",
    "commander": "^15.0.0",
    "esbuild": "^0.25.0",
    "ws": "^8.21.3",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@ironbird/react-native": "workspace:*",
    "@types/ws": "^8.18.1"
  }
}
